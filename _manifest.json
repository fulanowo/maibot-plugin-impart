{
  "manifest_version": 2,
  "id": "com.maibot.impart",
  "version": "2.0.0",
  "name": "银趴插件 Impart",
  "description": "MaiBot 银趴插件，包含PK、打胶、嗦牛子、查询、排行榜、透群友等功能",
  "author": {
    "name": "fulanowo",
    "url": "https://github.com/fulanowo"
  },
  "license": "MIT",
  "plugin_type": "game",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "swords"
    }
  },
  "urls": {
    "repository": "https://github.com/fulanowo/maibot-plugin-impart"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.5.1",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "sqlalchemy",
      "version_spec": ">=2.0.0"
    },
    {
      "type": "python_package",
      "name": "aiosqlite",
      "version_spec": ">=0.17.0"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=9.0.0"
    }
  ],
  "capabilities": ["send.text", "send.image"],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
